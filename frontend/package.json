{
  "name": "@trust-issues/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run check:bundle",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "tsx build/check-bundle.ts",
    "api:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@trust-issues/sim": "*",
    "openapi-fetch": "^0.17.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.1",
    "openapi-typescript": "^7.13.0",
    "vite": "^8.3.4"
  }
}
